def assess_password(password):
    # Common weak passwords
    weak_passwords = [
        "password",
        "123456",
        "qwerty",
        "admin",
        "letmein"
    ]

    # Dictionary to track criteria
    criteria = {
        "length": False,
        "uppercase": False,
        "lowercase": False,
        "digit": False,
        "special": False
    }

    special_chars = "!@#$%^&*()-_=+[]{}|;:',.<>?/"

    # Check length
    if len(password) >= 8:
        criteria["length"] = True

    # Check each character
    for char in password:
        if char.isupper():
            criteria["uppercase"] = True
        elif char.islower():
            criteria["lowercase"] = True
        elif char.isdigit():
            criteria["digit"] = True
        elif char in special_chars:
            criteria["special"] = True

    # Immediate rejection for common passwords
    if password.lower() in weak_passwords:
        return "Very Weak", criteria

    # Calculate score
    score = 0

    for value in criteria.values():
        if value:
            score += 1

    # Determine strength
    if score <= 2:
        strength = "Weak"
    elif score == 3:
        strength = "Moderate"
    elif score == 4:
        strength = "Strong"
    else:
        strength = "Very Strong"

    return strength, criteria


def display_results(password):
    strength, criteria = assess_password(password)

    print("\nPassword Analysis")
    print("-" * 20)
    print("Password:", "*" * len(password))
    print("Strength:", strength)

    print("\nCriteria Met:")
    for key, value in criteria.items():
        status = "Yes" if value else "No"
        print(f"{key.capitalize():12}: {status}")


def main():
    while True:
        password = input("\nEnter a password to assess: ")

        display_results(password)

        choice = input("\nCheck another password? (y/n): ").lower()

        if choice != "y":
            print("Goodbye!")
            break


# Run the program
main()
